#!/usr/bin/env python3
"""ctgc — Pipeline CLI（架构师/用户侧）。认证：CTGC_API_TOKEN 环境变量。
用法:
  ctgc create <task_id> <project> [priority]
  ctgc approve <task_id> [signed_by]
  ctgc cancel <task_id>
  ctgc advance <task_id> <status>
  ctgc status <task_id>
  ctgc agents
  ctgc audit <task_id>
"""
import json, os, sys, urllib.request

BASE = os.environ.get("CTGC_API_URL", "http://127.0.0.1:8800")
TOKEN = os.environ.get("CTGC_API_TOKEN", "")

def call(method, path, body=None, actor="architect"):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(BASE + path, data=data, method=method, headers={
        "Content-Type": "application/json",
        "Authorization": f"Bearer {TOKEN}",
        "X-CTGC-Actor": actor})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        return {"error": f"HTTP {e.code}", "detail": e.read().decode()[:200]}

def main():
    if len(sys.argv) < 2:
        print(__doc__); return 2
    cmd = sys.argv[1]
    a = sys.argv[2:]
    if cmd == "create" and len(a) >= 2:
        r = call("POST", "/tasks", {"task_id": a[0], "project": a[1],
                                    "priority": int(a[2]) if len(a) > 2 else 1})
    elif cmd == "approve" and a:
        r = call("POST", f"/tasks/{a[0]}/approve", {"signed_by": a[1] if len(a) > 1 else "user"})
    elif cmd == "cancel" and a:
        r = call("POST", f"/tasks/{a[0]}/cancel")
    elif cmd == "advance" and len(a) == 2:
        r = call("POST", f"/tasks/{a[0]}/advance", {"status": a[1]})
    elif cmd == "status" and a:
        r = call("GET", f"/tasks/{a[0]}")
    elif cmd == "agents":
        r = call("GET", "/agents")
    elif cmd == "audit" and a:
        r = call("GET", f"/audit?task_id={a[0]}")
    else:
        print(__doc__); return 2
    print(json.dumps(r, ensure_ascii=False, indent=1)[:2000])
    return 0

if __name__ == "__main__":
    sys.exit(main())
